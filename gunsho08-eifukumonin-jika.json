 ],
 "poems": [
  {
   "seq": "1",
   "text": "入あひのこゑする山の陰くれて花の木の間に月出にけり",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "春とたに思ひもあへぬけさの朝け山の霞はゝや立に鳬",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "朝嵐は外面の竹に吹あれて山の霞も春寒き比",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "外山には霞たな引むへしこそ野澤の雲も下消にけれ",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "なをさゆる夜半の雪けのうすくもり晴行月も又霞ぬる",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "花のうへにしはしうつろふ夕附日入ともなしに影消にけり",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "何となき草の花さく野への春雲にひはりの聲ものとけき",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "窓の梅のかほりなつかし朝明に圍なから聞鶯の聲",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "あくかるゝ心なからやさそはれん梅咲軒のはるの夕かせ",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "峯の霞ふもとの草のうす綠野山をかけて春めきに鳬",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "遠近の霞の色はふかけれと岸の柳そ淺みとりなる",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "木〓の心花ちかゝらし昨日けふ世はうすくもり春雨そふる",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "霞わたり長閑き暮に河きしの柳一もと春風そふく",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "折かさす道行人のけしきにて世はみな花の盛をそしる",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "さえかへる嵐を寒み足引の山のさくらも咲やかねぬる",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "遠近の鶯の音ものとかにて花の咲そふ宿の夕暮",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "一木つゝつきて咲なん我宿の花は見るほと久しかるへき",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "春とにかはらぬ物か梅の匂ひ櫻かいろにうつるこゝろは",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "峯のかすみ麓の花に鳥のこゑ野山のはるは夕なりけり",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "夕暮の霞につゝむ山本の花とけふりの里のむら〓〓",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "夕月日軒はの影はうつり消て花のうへにそしはし殘れる",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "何となく庭の梢はかすみふけて入かた晴る山のはの月",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "詠やるかすみの遠のはるの暮柳さくらの色そこもれる",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "枝かはす柳か末はなひけとも盛のはなは風もよきけり",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "吹はらふ山の嵐のははしきにおつる櫻はのとけかりけり",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "ちるとなみ花おちすさふ夕暮の風ゆるき日の二月の空",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "あひ思はてうたて散ゆく花にしも何あちきなく心そむらん",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "あやにくに吹たつ風のつらき哉あすまてよものけふの櫻に",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "殘なく散して庭の花の雪えたにをかへせ春のゆふ風",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "峯つゝきくれて吹たつ山風にさかぬ野へまて花そ散しく",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "瀧津せやいはもと白くよる花は流るとすれと又かへる也",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "流やらぬ花のしら浪立かへり春をとゝむる山川の水",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "明かたき秋の寐覺もかくやありし草の庵のよはの春雨",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "何となく寐覺の袂しほりわひをし明る空もよはの春雨",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "歸さの道もやまよふ夕暮のかすむ雲井にきゆる雁かね",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "入かたの月影かすむ山のはに歸る雁さへほのかなるこゑ",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "此ころよ井手のわたりもかくやらん山吹咲てかはつ鳴也",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "打いつる浪さへ色にうつろひぬ井手の川瀨の山吹の比",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "ゆく春をしたひかねてそ聞ゆなる靑葉のなかの鶯の聲",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "岩かくれ咲るつゝしの人しれす殘れる春の色もめつらし",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "神まつる卯月になれや榊葉にみしめはへたるあけの玉垣",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "ほとゝきすこゑも高根のよこ雲になき捨てゆく曙の空",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "卯の花の垣ねの月のうす雲に山ほとゝきすひと聲そ鳴",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "月雪の色にそまかふ卯の花のかきねつゝきのたそかれの宿",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "さなへなひく外面の小田のむら雨に山時鳥こゑおとすなり",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "楢の葉にむら雨かゝる山陰のくるゝ雲間に郭公なく",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "小山田のさなへの色はすゝしくて岡へこくらき杉の一村",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "山本のけふりの色も消はてぬ遠里むらの五月雨の比",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "五月雨のふるやの軒の糸水のくる人もなき暮そ淋しき",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "五月雨のはるゝ雲間の宵の月軒のあまりの影そすくなき",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "夕立の雲も殘らす空晴てすたれをのほる宵の月影",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "風の音もすゝしくそよく吳竹のふしうきよはの月の影哉",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "みしが夜はさし入月の影をこめて枕の山はゝや明にけり",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "雨はるゝ梢の靑葉いろそひて吹たつ風は露はらふなり",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "なく蟬のこゑさへすゝし吹風にむら雨ましる山のゆふかけ",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "旅人のあまた立よる夕木陰山川きよみすゝみ涼しも",
   "kana": "",
   "speaker": "",
   "page": 565,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "夜の雨に竹の葉末はなひき伏て朝けの窓の風の凉しさ",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "夏深き草のしげみむしけくのみ思ふおもひは道もとをらす",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "谷ふかき庵の軒のまつの風秋よりさきに秋をきく哉",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "吹かせも今宵はすゝし御秡する川瀨の浪に秋やさきたつ",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "いつしかと聞に心そ愁そむる荻のうへわたる秋のはつ風",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "何もなくかはるとなしの色さひて松も檜原も秋は見えけり",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "ひこほしのあふ夜をちかく思ふより我さへ空に詠をそする",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "天の川としのわたりを待よりもけふのくるゝは猶や久しき",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "秋草の花のひもとく比しもあれ吹なむすひそ野への夕風",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "宮城野やちくさのうへの秋の風なひくそ花のすかた成ける",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "おきて見る朝けの籬露しけし小萩かすゑの花になる比",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "出そむる尾花もはきも色そこき露の籬のけさの曙",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "更る夜の月と虫とは何なれや光もこゑもひとつにそすむ",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "みちのへや垣根の虫も聲更て月より外に行人もなし",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "虫のこゑ露の光もさよ更て霧にしめれる野への月影",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "きかしみしかけそふ比の月の色にねさめ秋なる荻の上かせ",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "秋の夜の月は心にすみけるを雲井にのみと何おもひげん",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "雨風は暮にや見ぬる大空の雲間に早き夜半の月影",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "村雲にかくれ顯れゆく月のはれも曇りも秋そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "秋風のひゝきは峰にさよ更て影遠くなる入かたの月",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "このまより月はたえ〓〓庭にもりて軒端にさはく夜半の松風",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "秋風の梢をはらふ夕暮の雲にはつるゝみか月のかけ",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "月にみかく露の光も〓くしてよな〓〓涼ノ竹の秋風",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "夕附日いはれの苔に影きえて岡の柳は秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "更行はまきのお山に霧はれて月影〓し宇治の川浪",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "其いろとさゝぬ夕の悲しきはおはなか風に薄雲の空",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "露繁き草葉のうへは靜にて下には虫の聲そみたるゝ",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "さま〓〓にうき世をおもふ夕暮のそてと草葉といつれ露けし",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "宵過て月また遲き山のはの雲にひかれる秋の稻妻",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "をしなへて紅葉はちかく成にけり夕日の山の秋のゆふくれ",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "はる〓〓とわたるや雁のこゑ遠し雲に色ある西の山のは",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "時雨つゝ秋すさましき岡のへの尾花にましる櫨の一本",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "やへきりのたつ山本のはる〓〓と田面におつる秋",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "打はちふ袖にも秋そすさましき露霜かゝる山の下道",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "末高き籬の花はかたふきて露おちつゝく雨の夕暮",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "嵐吹岡への秋はさむくして柞のもみち散そめぬなり",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "何となく寐覺の袖もうるほひぬ明やらぬ窓の秋のよの雨",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "何となき山の木のはは落すさひ時雨るゝ暮の秋そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "うす霧の朝けの梢いろさひて虫の音殘る森の下草",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "もろくなる桐のかれ葉は庭に落て嵐にましる村雨の音",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "露しけき草のうへより明そめて霧の山へそしはし夜深き",
   "kana": "",
   "speaker": "",
   "page": 566,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "とめかたき日數の秋をおもふよの月たに空をいそかさらなん",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "色殘〓花の籬はまた秋をはや霜しろしけさの朝明",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "浮雲は軒はの峯をこえかゝりしはし時雨て又過ぬなり",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "枯ておつる木の葉の上にかゝれはや時雨の音ももろく聞ゆる",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "さやかなる光もぬれてみゆる哉時雨の後の庭の月影",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "月のすかた猶有明の村雲に一そゝきする時雨をそ見る",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "もみち葉をさそひておろす山風にいく木の錦庭に敷らん",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "一はらひ勵しくおろすタ暮のあらしの末を木のはにそみる",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "朝日さす野原のをさゝ霜消て露としもなき光をそみる",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "山本はまた霧くらき曙のすそ野は霜の色にしらめる",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "窓たゝく嵐にさやく吳竹のよ〓にに雪をあすやとそ待",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "村鳥の羽音してたつ朝明の汀のあしも雪降にけり",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "雪の色にやゝしらみ行山のはの梢にきゆる有明の月",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "朝戶明の軒はに近く聞ゆなる梢のからす雪ふかきこゑ",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "宵のま〓雪はひとへの色なから薄雲晴て月そさやけき",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "雲はるゝ月は梢に更過て積りもそはぬ夜半の薄雪",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "遠近の里のわたりそ靜なるかよひ絕たる雪の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "浦風や雪の白浪吹はれてしはし霞める遠しまの松",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "むら〓〓に小松ましれる冬枯の野へすさましき夕暮の雨",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "寒き雨はかれ野の原に降しめて山松風の音たにもせす",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "解やらぬ池の汀のあさ氷こほれるほとゝつもる雪哉",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "とちわたる氷のひまを行なやみ常よりほそき山川の水",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "降雪にしられぬ程に交る雨の暮ゆく軒に音をたてぬる",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "くもる夜の庭はむら〓〓霰にてまかきの竹は風はらふなり",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "天乙女そてふる夜はの風さむみ月を雲井におもひやろ哉",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "あれぬ日の夕の空は長閑にて柳のすゑも春近く見ゆ",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "つゝむかた人めも常に忘るゝを世にもそもるのとよせもなし",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "此暮につゝむ泪はとゝめかねぬをさふる袖の下とをるまて",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "あやしくも心のうちそ亂れ行物おもふ身とはならしと思ふに",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "とにかくに晴ぬ思ひにむきそめて憂より先に物の悲しき",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "逢とはなきさによするしき浪の頻にぬるゝ袖を見せはや",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "いつまても命をかけて待へきになからへかたくなるそ悲しき",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "芦間わくる湊の小舟とにかくに障やすさをこりす待哉",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "いつとしもたのめぬ暮の玉章に解ぬにおとるつらさ社そへ",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "何となく今宵さへこそ待れけれあかぬきのふの心ならひに",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "またやもしと賴む心の今日さへよけさ別きとおもふ物から",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "空しくはおもひはつへき今宵ともしらてや人のたゝ明すらん",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "つゐに今宵こすしもならん後に社つらき人とは思ひはてなめ",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "後をとも賴ぬ中のたまさかにあふ夜は時のうつらすもかな",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "たまさかに逢はひと夜の時のまにうひも恨もいかにはるけん",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "馴しかたの哀はかりは捨すとも又逢見すは何にかはせん",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "思ひ過す其おり〓〓の心をもいつあひ見てかかゝりしもせん",
   "kana": "",
   "speaker": "",
   "page": 567,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "つゝみ暮す淚をゆるす時にして月をさたかにみるよはそなき",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "泪にも餘りて人のつらきよは慰にみし月さへもうし",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "いつまてか行衞さためぬ浮雲のうきて立ゐに物を思はん",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "大かたは賴むへくしもなき人のうからぬにこそ思ひ侘ぬれ",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "別てもまた夜は深き鳥のねを獨なこりの床に聞かな",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "思ひしる一ふしをたに見せかぬる心よはさそ我なからうき",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "有しよりも哀は添ひてみしよりもうさは增るに思ひかねぬる",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "宵〓〓の夢の行衞のあやしさよ我おもひ寢かひとの心か",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "おもふてふ〓とのはなくは今更に人のこゝろにまよはさらまし",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "をのつからおなし月をは詠ともおもふ思ひの我にしもにし",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "人戀る心はつねにあくかれてふると計の世にはいつまて",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "うれしかりし昨日の暮の契こそけふはつらさの數に成けれ",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "かけて待し月日を何に歎けん後も賴まぬ歸るさの道",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "おなし世を賴むかたにはあらねとも馴し名殘を忘れかねぬる",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "かはさすは夜比かさなるから衣かへす〓〓も身をそうらむる",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "其折をかきるとは猶おもはぬをいかなるふしにいつ替けん",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "日數とは哀いつまてかそへけんいく年月の中のへたてを",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "戀やまぬ身はとはりにかへれ共忘るゝ人のうさはゆるさす",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "限そと命をかけてかこてとも厭ふひとには其かひもなし",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "おもひ馴し我心こそ哀なれ賴まぬものを夕暮の空",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "憂はてをつれなやありてとはかりにむかふ夕そたへす悲しき",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "契けりまちけり哀其時の·とのは殘る水莖のあと",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "うかりしも哀なりしもあらぬ世の今になりてはみなそ戀しき",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "山松の梢の空のしらむまゝにかへにきえ行閨の月かけ",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "ひゝきつる松の嵐の音もせす月さしのほる夕暮の山",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "月も入鐘も聲やむ明くれの空しつかなる星の影哉",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "里遠く八こゑの鳥は音つれて月すみ〓き有明の空",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "月はゝや遠島かけに傾きぬしはしとゝめよ須磨の關守",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "大空の月よ何とて常ならんさしもすみうき此世とおもふに",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "山川のたゝ一筋のなかれこそあまたの瀧に落わかれけれ",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "しつみはてぬ入日は浪のうへにして鹽干に〓き磯の松原",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "峰ふかき嵐の音と聞はとに谷の松にそ吹おろしぬる",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "谷川の底のひゝきにかよふん高き梢のまつかせの音",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "聞しほるねさめの窓は夜ふかくて槇の葉くらき曉の雨",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "山風の吹わたるかと聞ほとに檜原に雨のかゝる成けり",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "濡まさる草葉の色にしられけりそゝくも見えぬ夕暮の雨",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "おく山の檜原かうへに雨落て雲ゐる谷に鳥かへるなり",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "夕暮の山きは〓く雨はれて雲おりかゝる杉のむらたち",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "たちみたれ風に浮ゆく雨雲に半いろこきゆふくれの山",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "風たちてむら〓〓わたる雨雲の晴る方より星出にけり",
   "kana": "",
   "speaker": "",
   "page": 568,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "別ゆく雲の絕間の見えてしも更に降そふ夕暮の雨",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "旅衣たつより袖は泪にてむすふまくらも野への夕露",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "ひにそへて都の空そ隔てまさる昨日の宿はけふのふる里",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "はしめなく迷ひ初ける長き夜の夢を此たひいかて覺さん",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "山あひにおりしつまれる白雲のしはしと見れはゝや消にけり",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "心をも何かとゝめん露の命しはしをくまのかりの宿に",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "暮はつる嵐の底にこたふなり宿とふ出の入相のかね",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "昔とは遠きをのみは何かいはん近き昨日もけふはむかしを",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "折しもあれ遠里けふり絕はてゝ夕のなかめ哀そふらん",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "こし方を忍ふ泪の玉くしけふたゝひあはぬ時そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "うちむれて麓にくたる山人のゆくさきくるゝ野への夕霧",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "人のうへのはかなき事を聞にしも身は行末のよゝのかね〓と",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "竹の編戶かこふともなき柴の垣物はかなけの賤か家居や",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "目のまへに見聞しひとのなき數をかそへ〓〓て我もいつまて",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "山里の軒はに近き椎柴のしゐてうき世にいつまてかへん",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "日にそへてうきふしゝけみ吳竹の世にへかたくも成まさる哉",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "山水の流を見ても住人のこゝろの塵をすゝけとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "197",
   "text": "手すさひにつけをく墨も行末は誰かあはれと水莖の跡",
   "kana": "",
   "speaker": "",
   "page": 569,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "198",
   "text": "なかれての末をも何か賴むへき飛鳥の川のあすしらぬよに",
   "kana": "",
   "speaker": "",
